# 高德 Web Service API Key（仅服务端使用）
# 获取地址：https://console.amap.com/
# 切勿使用 NEXT_PUBLIC_ 前缀，避免泄露到浏览器
AMAP_API_KEY=your_amap_web_service_key_here

# 高德地图 JS API Key（浏览器端使用，必须使用 NEXT_PUBLIC_ 前缀）
# 这是地图底图 SDK 的 Key，与上面的 Web Service Key 应分开管理
NEXT_PUBLIC_AMAP_JS_KEY=your_amap_js_api_key_here

# 高德地图 JS API 安全密钥（若控制台为 JS API 配置了安全密钥则填写）
NEXT_PUBLIC_AMAP_SECURITY_JS_CODE=your_amap_security_js_code_here